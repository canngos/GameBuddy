---
import SupportPage from '../../components/SupportPage.astro';
import { LANGS, DEFAULT_LANG, t, type Lang } from '../../i18n';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return LANGS.filter((lang) => lang !== DEFAULT_LANG).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Base
  lang={lang}
  path="support"
  title={t(lang, 'support.title')}
  description={t(lang, 'support.intro')}
>
  <SupportPage lang={lang} />
</Base>
