---
/**
 * Light/dark switch.
 *
 * The **pre-paint script lives in `Base.astro`, not here**, and that split is the whole
 * design. A theme applied after hydration means a flash of the wrong theme on every single
 * navigation — white for one frame before the page turns dark — which is the most visible
 * bug a themed static site can have. So the attribute is set by a tiny blocking script in
 * `<head>` before the first paint, and this component only handles the click.
 *
 * The two icons are both in the DOM and swapped with CSS rather than by rewriting the
 * button's contents. That keeps the click handler to one line and, more usefully, means the
 * icon is already correct at first paint for the same reason the colours are.
 */
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<button
  id="theme-toggle"
  type="button"
  class="grid h-9 w-9 place-items-center rounded-lg border border-line text-muted transition-colors hover:border-primary/40 hover:text-content"
  aria-label={t(lang, 'nav.toggleTheme')}
  title={t(lang, 'nav.toggleTheme')}
>
  {/* Sun — shown in dark mode, because it is what you would switch *to*. */}
  <svg
    class="hidden h-4.5 w-4.5 [data-theme='dark']_&:block"
    data-icon="sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>

  {/* Moon — shown in light mode. */}
  <svg
    class="h-4.5 w-4.5"
    data-icon="moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
</button>

<style>
  /* Which icon shows is decided by the theme attribute, in CSS, so it is right at first
     paint. Written here rather than as Tailwind utilities because the selector reaches up
     to an ancestor attribute, which utilities cannot express. */
  :global([data-theme='dark']) [data-icon='moon'] {
    display: none;
  }
  :global([data-theme='dark']) [data-icon='sun'] {
    display: block;
  }
</style>

<script>
  /**
   * Toggling, and remembering.
   *
   * `localStorage` only when the visitor actually chooses. Absent, the pre-paint script in
   * `Base.astro` follows `prefers-color-scheme` — so somebody who has never touched the
   * button keeps getting their system preference, including when they change it later. An
   * unconditional write on first load would freeze whatever they happened to arrive with.
   */
  const KEY = 'gamebuddy-theme';

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem(KEY, next);
    } catch {
      // Private browsing, or storage disabled. The theme still switches for this page —
      // it simply will not be remembered, which is a better outcome than an exception
      // stopping the click handler.
    }
  });
</script>
