---
/**
 * How to delete a GameBuddy account.
 *
 * **A Google Play requirement, not a courtesy.** Any app that lets people create an account
 * must publish a route to deleting it that is reachable without installing the app — someone
 * who has already uninstalled still has an account.
 *
 * Everything here describes what `DefaultAuthService.deleteAccount` actually does. A policy
 * that overstated ("everything is erased") would be both untrue and a worse answer, because
 * the honest behaviour — anonymising inside other people's conversations rather than erasing
 * — is the one that protects other users.
 */
import { CONTACT } from '../config';
import { dict, t, type Lang } from '../i18n';
import Reveal from './Reveal.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = dict(lang);
const removed = [d.del.r1, d.del.r2, d.del.r3, d.del.r4, d.del.r5, d.del.r6];
const kept = [d.del.k1, d.del.k2, d.del.k3];
const steps = [d.del.step1, d.del.step2, d.del.step3];
---

<article class="mx-auto max-w-3xl px-5 py-16">
  <h1 class="font-display text-4xl font-bold tracking-tight">{t(lang, 'del.title')}</h1>
  <p class="mt-4 text-lg text-muted">{t(lang, 'del.intro')}</p>

  <section class="mt-12">
    <h2 class="font-display text-2xl font-bold">{t(lang, 'del.inApp')}</h2>
    <ol class="mt-4 space-y-3 text-[15px] text-content/90">
      {
        steps.map((step, i) => (
          <li class="flex gap-3">
            <span class="gradient-text font-display font-bold" aria-hidden="true">
              {i + 1}
            </span>
            <span>{step}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mt-12">
    <h2 class="font-display text-2xl font-bold">{t(lang, 'del.noApp')}</h2>
    <p class="mt-4 text-[15px] leading-relaxed text-content/90">
      <a class="text-primary underline" href={`mailto:${CONTACT.support}`}>{CONTACT.support}</a>.
      {' '}{t(lang, 'del.noAppBody')}
    </p>
    <p class="mt-3 text-sm text-muted">
      {t(lang, 'del.formal')}{' '}
      <a class="text-primary underline" href={`mailto:${CONTACT.legal}`}>{CONTACT.legal}</a>
    </p>
  </section>

  <section class="mt-14">
    <h2 class="font-display text-2xl font-bold">{t(lang, 'del.removedTitle')}</h2>
    <ul class="mt-4 space-y-2">
      {
        removed.map((item) => (
          <li class="flex gap-3 text-[15px] text-content/90">
            <span class="text-online" aria-hidden="true">
              ✓
            </span>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-4 text-sm text-muted">{t(lang, 'del.removedNote')}</p>
  </section>

  <section class="mt-14">
    <h2 class="font-display text-2xl font-bold">{t(lang, 'del.keptTitle')}</h2>
    <p class="mt-3 text-sm leading-relaxed text-muted">{t(lang, 'del.keptIntro')}</p>
    <dl class="mt-6 space-y-6">
      {
        kept.map((item, i) => (
          <Reveal delay={i * 50}>
            <div class="rounded-2xl border border-line bg-surface/60 p-5">
              <dt class="font-semibold">{item.what}</dt>
              <dd class="mt-2 text-sm leading-relaxed text-muted">{item.why}</dd>
            </div>
          </Reveal>
        ))
      }
    </dl>
  </section>

  <section class="mt-14 rounded-2xl border border-line bg-raised/40 p-6">
    <h2 class="font-display text-lg font-bold">{t(lang, 'del.knowTitle')}</h2>
    <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted">
      <li>{t(lang, 'del.n1')}</li>
      <li>{t(lang, 'del.n2')}</li>
      <li>
        {t(lang, 'del.n3')}{' '}
        <a class="underline hover:text-content" href={`mailto:${CONTACT.legal}`}>{CONTACT.legal}</a>
      </li>
    </ul>
  </section>

  <p class="mt-10 text-sm text-muted">
    <a class="text-primary underline" href="/privacy">{t(lang, 'del.fullDetail')}</a>
  </p>
</article>
