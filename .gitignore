.env
*.env
!.env.example
.env-args
**/.env-args

secret/

# Scratch scripts at the repository root only. Anchored with a leading slash on purpose:
# a bare `tools/` matches a directory of that name at ANY depth, which silently swallowed
# GameBuddy-Model/tools/. That directory holds retrain.py, which the model-retrain image's
# ENTRYPOINT runs — so the image built and then crash-looped in production with
# "can't open file '/app/tools/retrain.py'". seed_local_gamers.py beside it survived only
# because it was committed before this rule existed.
/tools/

# Contents, not the directory itself. Git cannot re-include a file whose *parent* is
# excluded, so a plain `documentation/` would make the negation below impossible.
documentation/*

# The legal documents are tracked, deliberately. They are the terms and the privacy policy
# the store listings point at, and the ones registration records acceptance of — losing
# them on a fresh clone is not an option. Nothing in them is secret; the operator details
# are placeholders until a lawyer has read them.
!documentation/legal/

*-service-account.json
firebase-*.json
google-play-*.json

google-services.json

# Log files. Written when the backend runs on the host rather than in its container,
# where LOG_FILE points at a volume instead. See logging.file.name in application.yml.
logs/

# Build output
build/
out/
target/
*.jar
!gradle/wrapper/gradle-wrapper.jar

# Gradle
.gradle/

# IDEs
.idea/
*.iml
.vscode/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# Agent scratch
.claude/
backups/

SECURITY_REVIEW.md

# Scratch output from the Artifact tooling, never part of the project.
.artifact-build/
