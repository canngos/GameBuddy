# --- database (DUMMY VALUES) --------------------------------------------------------------
DB_NAME=gamebuddy
DB_USER=gamebuddy
DB_PASSWORD=local-dev-password
# Host port. Change if 5432 is already taken by another Postgres.
DB_PORT=5432

# --- secrets (DUMMY VALUES) ---------------------------------------------------------------
# Must decode to at least 32 bytes (256 bits) for HS256, or the application refuses to
# start. Generate: openssl rand -base64 32
JWT_SECRET=LDVCEKon2JU7bzDods2BnU33oWquOu1GjE7Gov3mpZw=
CHAT_ENCRYPTION_KEY=48A3PVP/gcxYEye35Ihf1Mq6BS1LK+WkBUNr4uGETF8=
INTERNAL_API_KEY=3e0bffdd4a71ab7396526844d8634f61a9dff173daf7e061

# --- the moderator account -------------------------------------------------
# Created on first start if no account with this address exists, and never touched again:
# setting a different password here later does nothing, by design. Leave both empty to
# create no staff account at all.
#
# Generate a password with: openssl rand -base64 24
MODERATOR_EMAIL=
MODERATOR_PASSWORD=

# --- avatar review ---------------------------------------------------------
# How long an image the classifier was genuinely unsure about waits for a human before it
# is published anyway. Anything the model was confident about was already rejected, and
# everything published stays reportable — this is a promise about how long somebody's
# photograph can be held without an answer, not a safety threshold.
AVATAR_PUBLISH_AFTER=P3D

# --- ports -----------------------------------------------------------------
BACKEND_PORT=8080
MODEL_PORT=8000
# Kibana is the log UI; Elasticsearch is the API behind it.
KIBANA_PORT=5601
ELASTICSEARCH_PORT=9200

# --- logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# One line per HTTP request. Set to WARN to keep only the failures.
ACCESS_LOG_LEVEL=INFO
# Tags every document in Elasticsearch, so one cluster can hold more than one deployment
# and they can still be told apart.
ENVIRONMENT=local

# --- object storage (Cloudflare R2) ----------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_UPLOADS_BUCKET=
R2_MEDIA_BUCKET=
R2_PUBLIC_URL=
