# Copy to .env and adjust. `docker compose` reads .env automatically.
#
#   cp .env.example .env
#
# Everything below is either a placeholder or a throwaway value generated for this
# template. Nothing here is a credential to any real account, and nothing here is what a
# running deployment uses — .env is git-ignored and holds the real values.
#
# The generated secrets are good enough for a local stack that only listens on localhost.
# Regenerate every one of them before anything is reachable from outside your machine;
# the command is given next to each.

# --- database --------------------------------------------------------------
DB_NAME=gamebuddy
DB_USER=gamebuddy
DB_PASSWORD=local-dev-password
# Host port. Change if 5432 is already taken by another Postgres.
DB_PORT=5432

# --- secrets ---------------------------------------------------------------
# Must decode to at least 32 bytes (256 bits) for HS256, or the application refuses to
# start. Generate: openssl rand -base64 32
JWT_SECRET=LDVCEKon2JU7bzDods2BnU33oWquOu1GjE7Gov3mpZw=

# Chat message encryption at rest. Must decode to exactly 16, 24 or 32 bytes — anything
# else fails startup with the byte count it actually got.
# Generate: openssl rand -base64 32
#
# Changing this after messages exist makes them undecryptable. There is a key_version column
# for rotation; rotating properly means keeping the old key around to read old messages.
CHAT_ENCRYPTION_KEY=48A3PVP/gcxYEye35Ihf1Mq6BS1LK+WkBUNr4uGETF8=

# Shared between the backend and the model service, and it must be the *same value in both*.
# Compose passes this one variable to each, so they cannot drift here — but if you run either
# outside compose, check this first. A mismatch does not announce itself: the model answers
# 503 and the feed reports "Recommendation service unavailable", which reads as the model
# being down rather than a wrong secret.
# Generate: openssl rand -hex 24
INTERNAL_API_KEY=3e0bffdd4a71ab7396526844d8634f61a9dff173daf7e061

# --- ports -----------------------------------------------------------------
BACKEND_PORT=8080
MODEL_PORT=8000

# --- logging ---------------------------------------------------------------
# DEBUG on com.gamebuddy if you want to see what the services are doing.
LOG_LEVEL=INFO

# --- object storage (Cloudflare R2) ----------------------------------------
# Deliberately blank. An empty R2_ACCESS_KEY_ID selects the local-disk implementation, so
# development needs no credentials at all and nothing leaves the machine. Fill these in
# only if you have your own R2 account and want to exercise the real storage path.
#
# Never commit real values here. This file is in the repository; .env is not, and that is
# the whole distinction between them.
#
# Two buckets, both in the EU jurisdiction because they hold user-uploaded images and
# the operator is in Finland:
#
#   gamebuddy-uploads  private. Everything lands here first and stays until moderation
#                      clears it. Nothing in this bucket is reachable without a signed URL.
#   gamebuddy-media    public. Approved avatars and the cosmetic assets (frames, banners).
#                      An object only moves here once it has been approved.
#
# The split is the whole point: with one bucket, "public" would mean public for
# unreviewed uploads too, and there is no way to make r2.dev serve only some prefixes.
R2_ACCOUNT_ID=

# From an R2 > API Tokens entry with Object Read & Write scoped to the two buckets above,
# so it cannot create or delete a bucket. The secret is shown once at creation; if it is
# lost, roll the token rather than hunting for it.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Note the `.eu.` — the EU jurisdiction has its own endpoint host, and the default
# (account-id.r2.cloudflarestorage.com) returns a permission error for these buckets
# rather than saying anything about jurisdiction.
R2_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
R2_UPLOADS_BUCKET=gamebuddy-uploads
R2_MEDIA_BUCKET=gamebuddy-media

# Where approved objects are served from. r2.dev is free but rate-limited and Cloudflare
# says outright it is not for production — swap it for a custom domain on the bucket once
# there is a domain to point at it. That change is this one variable.
R2_PUBLIC_URL=
