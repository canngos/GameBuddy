# --- database -----------------------------------------------------------------------------
DB_NAME=gamebuddy
DB_USER=gamebuddy
# No default on purpose: set a strong password. A working password must never live in this
# committed template — copying it into a real deployment is how a database gets owned.
DB_PASSWORD=REPLACE_ME__set_a_strong_db_password
# The backend logs in with THIS password as a least-privileged, non-superuser role — never the
# superuser above (a superuser DB login is RCE via COPY ... FROM PROGRAM). Keep it distinct.
# Generate: openssl rand -base64 24
DB_APP_PASSWORD=REPLACE_ME__set_the_app_login_password
# Host port. Change if 5432 is already taken by another Postgres.
DB_PORT=5432

# --- secrets ------------------------------------------------------------------------------
# These are placeholders that DELIBERATELY fail startup, so a blind `cp .env.example .env`
# cannot boot with a public signing key. Replace each before first run:
#   JWT_SECRET, CHAT_ENCRYPTION_KEY:  openssl rand -base64 32   (must decode to >=32 bytes)
#   INTERNAL_API_KEY:                 openssl rand -hex 24
JWT_SECRET=REPLACE_ME__openssl_rand_base64_32
CHAT_ENCRYPTION_KEY=REPLACE_ME__openssl_rand_base64_32
INTERNAL_API_KEY=REPLACE_ME__openssl_rand_hex_24

# --- the moderator account -------------------------------------------------
# Created on first start if no account with this address exists, and never touched again:
# setting a different password here later does nothing, by design. Leave both empty to
# create no staff account at all.
#
# Generate a password with: openssl rand -base64 24
MODERATOR_EMAIL=
MODERATOR_PASSWORD=

# --- avatar review ---------------------------------------------------------
# How long an image the classifier was genuinely unsure about waits for a human before it
# is published anyway. Anything the model was confident about was already rejected, and
# everything published stays reportable — this is a promise about how long somebody's
# photograph can be held without an answer, not a safety threshold.
AVATAR_PUBLISH_AFTER=P3D

# --- legal documents -------------------------------------------------------
# Where the app links to for the terms and the privacy policy. Both stores need a privacy
# policy URL on the listing, and Apple wants the terms reachable from inside the app too.
# The source documents are in documentation/legal/ — these must serve them before the
# first store submission.
#
# Read by the Expo client (EXPO_PUBLIC_ prefix), not by the backend.
EXPO_PUBLIC_TERMS_URL=https://gamebuddy.app/terms
EXPO_PUBLIC_PRIVACY_URL=https://gamebuddy.app/privacy

# --- ports -----------------------------------------------------------------
BACKEND_PORT=8080
MODEL_PORT=8000

# --- logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# One line per HTTP request. Set to WARN to keep only the failures.
ACCESS_LOG_LEVEL=INFO
# Distinguishes one deployment from another in log output (local, staging, production…).
ENVIRONMENT=local

# --- object storage (Cloudflare R2) ----------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_UPLOADS_BUCKET=
R2_MEDIA_BUCKET=
R2_PUBLIC_URL=
