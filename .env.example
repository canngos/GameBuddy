# --- database -----------------------------------------------------------------------------
DB_NAME=gamebuddy
DB_USER=gamebuddy
# No default on purpose: set a strong password. A working password must never live in this
# committed template — copying it into a real deployment is how a database gets owned.
DB_PASSWORD=REPLACE_ME__set_a_strong_db_password
# The backend logs in with THIS password as a least-privileged, non-superuser role — never the
# superuser above (a superuser DB login is RCE via COPY ... FROM PROGRAM). Keep it distinct.
# Generate: openssl rand -base64 24
DB_APP_PASSWORD=REPLACE_ME__set_the_app_login_password
# Host port. Change if 5432 is already taken by another Postgres.
DB_PORT=5432

# --- secrets ------------------------------------------------------------------------------
# These are placeholders that DELIBERATELY fail startup, so a blind `cp .env.example .env`
# cannot boot with a public signing key. Replace each before first run:
#   JWT_SECRET, CHAT_ENCRYPTION_KEY:  openssl rand -base64 32   (must decode to >=32 bytes)
#   INTERNAL_API_KEY:                 openssl rand -hex 24
JWT_SECRET=REPLACE_ME__openssl_rand_base64_32
CHAT_ENCRYPTION_KEY=REPLACE_ME__openssl_rand_base64_32
INTERNAL_API_KEY=REPLACE_ME__openssl_rand_hex_24

# --- the moderator console ---------------------------------------------------
# Nothing to configure. Staff accounts are ordinary accounts with role = 'ADMIN', made by
# signing up through the app and then promoting the row by hand — see "The moderator
# console" in the README. The backend has no environment variable that grants ADMIN, on
# purpose: whoever can set the environment would otherwise be able to mint an administrator.
#
# The two variables below are the QA harness only. They tell the Maestro admin flow which
# staff account to type into the login form; the backend never reads them, and leaving them
# empty just skips 06-admin.
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=

# --- avatar review ---------------------------------------------------------
# How long an image the classifier was genuinely unsure about waits for a human before it
# is published anyway. Anything the model was confident about was already rejected, and
# everything published stays reportable — this is a promise about how long somebody's
# photograph can be held without an answer, not a safety threshold.
AVATAR_PUBLISH_AFTER=P3D

# --- legal documents -------------------------------------------------------
# Where the app links to for the terms and the privacy policy. Both stores need a privacy
# policy URL on the listing, and Apple wants the terms reachable from inside the app too.
# The source documents are in documentation/legal/ — these must serve them before the
# first store submission.
#
# Read by the Expo client (EXPO_PUBLIC_ prefix), not by the backend.
EXPO_PUBLIC_TERMS_URL=https://findgamebuddy.com/terms
EXPO_PUBLIC_PRIVACY_URL=https://findgamebuddy.com/privacy

# --- ports -----------------------------------------------------------------
BACKEND_PORT=8080
MODEL_PORT=8000

# --- logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# One line per HTTP request. Set to WARN to keep only the failures.
ACCESS_LOG_LEVEL=INFO
# Distinguishes one deployment from another in log output (local, staging, production…).
ENVIRONMENT=local

# --- object storage (Cloudflare R2) ----------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_UPLOADS_BUCKET=
R2_MEDIA_BUCKET=
R2_PUBLIC_URL=

# ===========================================================================
# Required by docker-compose.prod.yml only
# ===========================================================================
# These are not needed for a local `docker compose up`, but the production
# overlay declares them as ${VAR:?...} — it refuses to start rather than boot
# a half-configured deployment. They were missing from this file, so following
# it produced a stack that would not come up; the compose files are the
# authority, and this section now matches them.

# --- TLS and hostname ------------------------------------------------------
# The API hostname Caddy requests a certificate for. Must resolve to this
# server and be GREY-CLOUDED in Cloudflare: proxying intercepts the ACME
# challenge and sits in front of the STOMP WebSocket.
DOMAIN=api.findgamebuddy.com
# Where Let's Encrypt sends expiry warnings. A real, monitored inbox.
ACME_EMAIL=contact@findgamebuddy.com

# --- Redis -----------------------------------------------------------------
# Redis has no password by default and the prod overlay does not publish its
# port, but an unauthenticated Redis reachable from any container is still a
# bad idea. Generate: openssl rand -base64 24
REDIS_PASSWORD=

# --- billing ---------------------------------------------------------------
# The shared secret RevenueCat sends verbatim in the Authorization header.
# RevenueCatWebhookController refuses to start without it, because an unset
# secret would match an empty header and hand out free subscriptions.
# Generate with `openssl rand -base64 32` and paste the SAME value into the
# webhook configuration in the RevenueCat dashboard.
REVENUECAT_WEBHOOK_TOKEN=

# --- push notifications ----------------------------------------------------
# Absolute path ON THE HOST to the Firebase admin service-account JSON. The prod
# overlay mounts it read-only at /run/secrets/firebase-service-account.json inside
# the container, so this is the source, not the destination — pointing it at the
# container path makes compose try to mount a file that does not exist.
# Never commit the file itself; `secret/` is ignored for that reason.
FIREBASE_SERVICE_ACCOUNT=/home/gamebuddy/gamebuddy/secret/firebase-service-account.json

# --- outbound mail (Brevo) -------------------------------------------------
# Used for verification and password-reset mail. Locally a logging sender
# stands in, so these only matter in production.
#
# MAIL_FROM must be an address on the SENDING SUBDOMAIN, mail.findgamebuddy.com,
# which is the domain authenticated with Brevo (brevo-code TXT, brevo1/brevo2
# DKIM, DMARC p=none). Brevo refuses to relay for any sender it cannot prove you
# own: "the sender you used ... is not valid. Validate your sender or
# authenticate your domain".
#
# Do NOT put support@ or contact@findgamebuddy.com here. Those are INBOUND
# addresses on the root domain, delivered by Cloudflare Email Routing, whose SPF
# (include:_spf.mx.cloudflare.net) covers Cloudflare and not Brevo. Keeping
# sending on its own subdomain is why the two never collide — a domain may hold
# only one SPF record, so folding Brevo into the root would mean editing the
# record that receives your legal mail.
MAIL_HOST=smtp-relay.brevo.com
MAIL_FROM=noreply@mail.findgamebuddy.com
# Brevo also allowlists source IPs. A new server hits "525 5.7.1 Unauthorized IP
# address" on its first send until it is added under SMTP & API > Authorized IPs.
SMTP_EMAIL=
SMTP_EMAIL_PWD=
